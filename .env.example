# Copy to .env.local and fill in. Everything is optional for `pnpm dev`:
# features that need a missing key degrade gracefully in development.

# Chat (required in production)
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=

# Rate limiting (required in production; an in-memory limiter is used in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Total chat requests allowed per day across all visitors. Defaults to 200.
CHAT_DAILY_LIMIT=

# Feedback emails (required in production; logged to the console in dev)
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
# Optional. Must be a sender verified in Resend. Defaults to onboarding@resend.dev.
FEEDBACK_FROM_EMAIL=

# Optional. Public site URL used for metadata, sitemap and robots.
# Falls back to the Vercel URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
